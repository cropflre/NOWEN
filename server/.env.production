# 后端生产环境配置

# 服务端口（容器内由 Nginx 39000 转发到此端口）
PORT=39001

# Node 环境
NODE_ENV=production

# 前端地址（CORS 白名单，可选）
# FRONTEND_URL=http://localhost:39000

# ========== AI 智能分类配置（可选） ==========
# 支持 openai | gemini | custom (兼容 OpenAI 协议的本地模型如 Ollama)
# AI_PROVIDER=openai
# AI_API_KEY=sk-xxx
# AI_MODEL=gpt-4o-mini
