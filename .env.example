# 环境变量配置示例
# 复制此文件为 .env.local 进行本地配置

# ========== 前端配置（VITE_ 前缀） ==========

# API 基础地址
# 开发环境：http://localhost:39101
# 生产环境：建议留空，由 http://host:39000/api 同源反向代理
VITE_API_BASE=http://localhost:39101

# 应用标题（可选）
VITE_APP_TITLE=Nebula Portal

# ========== 后端配置 ==========

# 服务端口
# 开发环境默认 39101；生产环境默认 39001
PORT=39101

# Node 环境
NODE_ENV=development

# 前端地址（用于 CORS，可选）
# FRONTEND_URL=http://localhost:39100

# 一行开发启动器也支持通过 shell 环境变量覆盖首选端口：
# NOWEN_WEB_PORT=39100 NOWEN_API_PORT=39101 npm run dev
